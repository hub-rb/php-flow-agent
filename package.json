  "repository": {
    "type": "git",
    "url": "git+https://github.com/hub-rb/php-flow-agent.git"
  },
  "homepage": "https://github.com/hub-rb/php-flow-agent#readme",
  "bugs": {
    "url": "https://github.com/hub-rb/php-flow-agent/issues"
  },
  "dependencies": {
    "@opencode-ai/plugin": "^1.14.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.0.0"
  }
}
